---
import { render } from "astro:content";
import { getPublishedPosts } from "../posts";
import Layout from "../layouts/Layout.astro";

const posts = await getPublishedPosts();
---

<Layout title="Velkommen!">
    <img
        src="/assets/construction.gif"
        alt="Under construction"
        class="py-4"
    />
    <h1>Velkommen!</h1>
    <p>… til mitt personlige nettsted !</p>
    <hr/>

    <h2>Siste innlegg</h2>
    <div class="space-y-1">
        {
            posts.map(async (post) => {
                const { Content } = await render(post);
                const { title, publishedAt } = post.data;
                return (
                    <article id={post.id} class="p-2 bg-linear-to-t from-paper to-white/50 border shadow">
                        <h3 class="m-0">{title}</h3>
                        <time datetime={publishedAt.toISOString()}>
                            {publishedAt.toLocaleDateString("no", { timeZone: "Europe/Oslo" })}
                        </time>

                        <Content />
                    </article>
                );
            })
        }
    </div>
</Layout>
